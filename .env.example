# ==========================================
# CircularIQ Environment Configuration
# ==========================================

# Application
PROJECT_NAME=CircularIQ
VERSION=1.0.0
API_V1_STR=/api
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite)
# For PostgreSQL: postgresql://username:password@localhost:5432/circulariq
# For SQLite (default zero-friction): sqlite:///./circulariq.db
DATABASE_URL=sqlite:///./circulariq.db

# Storage Directories
CHROMA_PERSIST_DIRECTORY=./chroma_db
UPLOAD_DIRECTORY=./uploads

# ==========================================
# Nexus API Configuration (Official College Portal)
# ==========================================
# Specify your institution's Nexus API details here once provided.
# CircularIQ treats Nexus as a modular integration with defensive health checks.
NEXUS_API_BASE_URL= https://nexusapi.navigatelabs.ai
NEXUS_API_KEY= sk-jOv67PAD7q2bRW5KcUznkg
NEXUS_API_TOKEN=

# ==========================================
# AI / LLM Configuration
# ==========================================
# Options: "gemini", "openai", "local_rule_engine"
# When set to "local_rule_engine", CircularIQ operates reliably without external API costs or rate-limits.
LLM_PROVIDER=local_rule_engine
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash
